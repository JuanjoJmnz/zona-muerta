---
import PostLayout from "../../layouts/PostLayout.astro";

interface PostFrontmatter {
  title: string;
  date: string;
  duration: string;
  category: string;
  catClass?: string;
  imgClass?: string;
  thumbImg?: string; // Añadido para la miniatura
  excerpt: string;
  layout?: string;
}

interface MarkdownPost {
  url: string;
  frontmatter: PostFrontmatter;
}

export async function getStaticPaths() {
  const postFiles = import.meta.glob<MarkdownPost>("../posts/*.md", {
    eager: true,
  });

  // Ordenamos por fecha (más reciente primero)
  const allPosts: MarkdownPost[] = Object.values(postFiles).sort((a, b) => {
    return (
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
    );
  });

  const uniqueCategories: string[] = [
    ...new Set(
      allPosts.map((post) => post.frontmatter.category).filter(Boolean),
    ),
  ];

  return uniqueCategories.map((category: string) => {
    let urlParam = category.toLowerCase().replace(/\s+/g, "-");
    if (urlParam === "x" || urlParam === "/x/") {
      urlParam = "-x-";
    }

    const filteredPosts = allPosts.filter(
      (post) => post.frontmatter.category === category,
    );

    return {
      params: { category: urlParam },
      props: {
        categoryName: category,
        categorySlug: urlParam,
        posts: filteredPosts,
      },
    };
  });
}

interface Props {
  categoryName: string;
  categorySlug: string;
  posts: MarkdownPost[];
}

const { categoryName, posts } = Astro.props as Props;
const finalCategoryTitle =
  categoryName === "x" || categoryName === "-x-" ? "/x/" : categoryName;
---

<PostLayout title={`Categoría: ${finalCategoryTitle}`}>
  <main class="archive-list-page">
    <div class="archive-header" style="margin-bottom: 2rem;">
      <p
        style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--red); margin: 0;"
      >
        BASE DE DATOS
      </p>
      <h1
        class="page-title"
        style="font-family: var(--font-disp); font-size: 1.5rem; margin-top: 0.5rem; border: none; padding: 0;"
      >
        Transmisiones en: {finalCategoryTitle}
      </h1>
      <p style="font-size: 0.85rem; color: var(--text2); margin-top: 0.25rem;">
        Se han recuperado {posts.length} archivos clasificados en la base de datos.
      </p>
    </div>

    <section class="posts-column">
      {
        posts.map((post) => (
          <>
            <article class="post-row">
              <div class="post-row-text">
                <div
                  class={`post-cat ${post.frontmatter.catClass || "cat-sistema"}`}
                >
                  {post.frontmatter.category === "x" ||
                  post.frontmatter.category === "-x-"
                    ? "/x/"
                    : post.frontmatter.category}
                </div>
                <h2 class="post-row-title">
                  <a href={post.url}>{post.frontmatter.title}</a>
                </h2>
                <p class="post-row-excerpt">{post.frontmatter.excerpt}</p>

                <div
                  class="post-meta"
                  style="margin-top: 0.5rem; font-size: 0.75rem; color: var(--text2);"
                >
                  <span>{post.frontmatter.date}</span>
                  <span class="sep"> · </span>
                  <span>{post.frontmatter.duration} lectura</span>
                </div>
              </div>

              <div class={`post-row-thumb ${post.frontmatter.imgClass || ""}`}>
                {post.frontmatter.thumbImg ? (
                  <img
                    src={post.frontmatter.thumbImg}
                    alt={post.frontmatter.title}
                    style="width:100%; height:100%; object-fit:cover;"
                  />
                ) : null}
              </div>
            </article>
            <div class="post-divider" />
          </>
        ))
      }
    </section>
  </main>
</PostLayout>

<style>
  .archive-list-page .post-row {
    display: flex !important;
    align-items: flex-start !important;
  }

  .archive-list-page .post-row-title {
    border: none !important;
    padding: 0 !important;
    margin-top: 0.25rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 1.25rem !important;
  }

  .archive-list-page .post-row-title a {
    text-decoration: none !important;
    border: none !important;
  }

  .archive-list-page .post-row-thumb {
    flex-shrink: 0 !important;
    width: 120px; /* Ajusta este ancho según necesites */
    height: 80px;
    margin-left: 1.5rem;
  }
</style>
